# Template for ~/junction-2026/.env on the server. The real file lives ONLY on the server:
# never in git, never in the image.

# Used by the db service and by DATABASE_URL in docker-compose.yml.
POSTGRES_PASSWORD=change-me

# Better Auth. Secret: `openssl rand -base64 32` (a different one than locally).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://valinor.ink:9090

# Gemini API key for the Mastra purchasing agent. Empty = mock model.
GOOGLE_GENERATIVE_AI_API_KEY=

# Do NOT set APP_TAG here: CI would keep deploying that old image.
# Rollback only: APP_TAG=sha-a1b2c3d docker compose up -d app
