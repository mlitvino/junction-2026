# Template for ~/app/.env on the server. The real file lives ONLY on the server:
# never in git, never in the image.

# Used by the db service and by DATABASE_URL in docker-compose.yml.
POSTGRES_PASSWORD=change-me

# Do NOT set APP_TAG here: CI would keep deploying that old image.
# Rollback only: APP_TAG=sha-a1b2c3d docker compose up -d app
