# Copy to .env and adjust (the pnpm data:* scripts read .env; Next.js reads it too).

# true → api-client returns data from src/client/mocks (no backend needed)
NEXT_PUBLIC_USE_MOCKS=false

# Local Postgres from compose.dev.yml. Dev-only credentials, not secrets.
DATABASE_URL=postgres://app:app@localhost:5432/app

# Better Auth (login + password). Secret: run `openssl rand -base64 32`, at least 32 characters.
# URL: the public origin of the app (used for cookies, redirects and origin checks).
BETTER_AUTH_SECRET=awdawudkhjawildjn
BETTER_AUTH_URL=http://localhost:3000

# Gemini API key (Google AI Studio) for the Mastra purchasing agent (google/gemini-3.8-flash).
# Leave empty to run the agent on a mock model. Use a key with a spending limit.
GOOGLE_GENERATIVE_AI_API_KEY=

# Valio Aimo challenge API (docs/valio-aimo-openapi.json). Base URL without trailing slash; key from the organisers.
# Used by `pnpm data:fetch` (downloads the static files into data/valio/) and by the server for live prices/availability.
# Leave VALIO_API_KEY empty to serve deterministic mock prices/availability instead (source: "mock").
VALIO_API_URL=https://junction26.valioaimo.fi/api/
VALIO_API_KEY=
