{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(.env.development)",
      "Read(.env.production)",
      "Read(.env.test)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(sudo *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Read(//mnt/c/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.npmrc)",
      "Read(~/.docker/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.git-credentials)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Read(~/.bash_history)",
      "Edit(.env)",
      "Edit(.env.local)",
      "Edit(.env.*.local)",
      "Edit(.env.development)",
      "Edit(.env.production)",
      "Edit(.env.test)",
      "WebFetch"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(git push *)",
      "Bash(git -C *)",
      "Bash(git clean *)",
      "Bash(git reset --hard*)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(find * -delete*)",
      "Edit(package.json)",
      "Edit(.vscode/**)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "./.env",
        "./.env.local",
        "~/.ssh",
        "~/.aws",
        "/mnt/c",
        "~/.claude/.credentials.json",
        "~/.npmrc",
        "~/.docker",
        "~/.config/gcloud",
        "~/.config/gh",
        "~/.git-credentials",
        "~/.gnupg",
        "~/.kube",
        "~/.bash_history"
      ]
    },
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "github.com",
        "*.github.com",
        "fonts.googleapis.com",
        "fonts.gstatic.com"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/guard.sh"
          }
        ]
      }
    ]
  }
}
